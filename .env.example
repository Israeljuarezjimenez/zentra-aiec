# Copia este archivo como .env. No compartas .env ni lo subas a GitHub.
# Obtén el token escribiendo /newbot a @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
# Atlas > Connect > Drivers > Python. Sustituye usuario y contraseña.
MONGODB_URI=
MONGODB_DATABASE=aiec
# Generada automáticamente por: python -m aiec setup
FLASK_SECRET_KEY=
PORT=5050
# La cuenta gratuita de Claude Desktop no incluye la API.
# Se deja desactivado: habilitarlo requiere clave y créditos de Anthropic.
AUTO_REPLY_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# WhatsApp Cloud API de Meta. Es el canal de mensajes, no una clave de Claude.
# Habilita el canal después de configurar el secreto de la aplicación y su webhook HTTPS.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_WEBHOOK_PORT=5051
